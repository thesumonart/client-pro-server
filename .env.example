# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Every variable below is validated by
# src/config/env.ts on boot — the process exits immediately if any is invalid.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# HTTP port the Express/Socket.io server listens on
PORT=5000

# Must start with mongodb:// or mongodb+srv://
MONGODB_URI=mongodb://127.0.0.1:27017/client-pro

# Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-random-string-32-chars
JWT_REFRESH_EXPIRES=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
